# Gradle outputs — anchored patterns so no source path can match
# (java package roots are com/strife/..., see ADR-017; never a bare "build" dir under src/)
.gradle/
/mod/build/
/mod/*/build/
/mod/*/*/build/
out/
/mod/*/run/
/mod/*/run*/

# IDE
.idea/
.vscode/
*.iml
.classpath
.project
.settings/
bin/

# OS
.DS_Store
Thumbs.db

# local scratch
*.log
